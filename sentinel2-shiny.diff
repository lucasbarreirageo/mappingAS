@@ -0,0 +1,54 @@
+% Generated by roxygen2: do not edit by hand
+% Please edit documentation in R/sentinel2.R
+\name{s2_raster_local}
+\alias{s2_raster_local}
+\title{Crop a Sentinel-2 / Esri LULC mosaic to an area of interest}
+\usage{
+s2_raster_local(
+  aoi,
+  year = 2023,
+  src = NULL,
+  base_url = NULL,
+  mask = TRUE,
+  cache = TRUE,
+  cache_dir = NULL
+)
+}
+\arguments{
+\item{aoi}{An \code{sf}/\code{sfc} polygon (any CRS), e.g. an EOO hull or the
+union of AOO cells.}
+
+\item{year}{Integer year (2017-2023, default \code{2023}).}
+
+\item{src}{Optional path/URL to a single Esri LULC GeoTIFF (ends in
+\code{.tif}, used as-is), or a base-URL prefix that replaces the default
+bucket. If \code{NULL} (default) the public bucket is used through
+\code{/vsicurl/}.}
+
+\item{base_url}{Base URL of the public bucket (see \code{\link{s2_source_url}}).}
+
+\item{mask}{Logical; if \code{TRUE} (default) pixels outside the polygon are
+set to \code{NA}.}
+
+\item{cache}{Logical; cache the windowed crops on disk (default \code{TRUE}).}
+
+\item{cache_dir}{Directory for the crop cache (default under \code{tempdir()}).}
+}
+\value{
+A \pkg{terra} \code{SpatRaster} of Esri land-cover codes for the AOI.
+}
+\description{
+Global analogue of \code{\link{mb_raster_local}} for the Esri / Impact
+Observatory 10 m Annual Land Use Land Cover product. Determines the MGRS
+grid-zone tile(s) intersecting \code{aoi}, streams a windowed read of each
+via GDAL's \code{/vsicurl/} driver (no Google Earth Engine, no account),
+masks to the polygon and, when the AOI spans more than one tile, merges the
+pieces (reprojected to geographic coordinates for display). For accurate area
+statistics the assessment path tabulates each tile in its native projection
+and sums, rather than reprojecting; use \code{\link{summarise_conversion}} on
+the class areas for that.
+}
+\seealso{
+\code{\link{esri_legend}}, \code{\link{s2_source_url}},
+\code{\link{mb_raster_local}}
+}
